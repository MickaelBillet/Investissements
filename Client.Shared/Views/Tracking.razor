@page "/suivi"
@inject TrackingViewModel ViewModel
@inject ILocalizationService L

<PageTitle>@L.Translate("Nav_AppTitle")</PageTitle>

@if (ViewModel.IsLoading)
{
    <MudStack AlignItems="AlignItems.Center" Style="padding:64px 0;">
        <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Primary" />
    </MudStack>
}
else
{
    <MudTabs Rounded="true" ApplyEffectsToContainer="true">
        <MudTabPanel Text="@L.Translate("Tracking_Tab_History")">
            <div style="height: calc(100vh - 230px);">
                @if (ViewModel.HistoryError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@ViewModel.HistoryError</MudAlert>
                }
                else
                {
                    <HistoryChart ROIC_Series="@ViewModel.ROIC_Series"
                                  LifeStrategySeries="@ViewModel.LifeStrategySeries"
                                  MsciWorldSeries="@ViewModel.MsciWorldSeries" />
                }
            </div>
        </MudTabPanel>
        <MudTabPanel Text="@L.Translate("Tracking_Tab_BondSchedule")">
            <div style="height: calc(100vh - 230px);overflow-y:auto;">
                @if (ViewModel.BondScheduleError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@ViewModel.BondScheduleError</MudAlert>
                }
                else
                {
                    <MudSwitch T="bool" @bind-Value="@ViewModel.BondScheduleQuarterlyView"
                               Label="@L.Translate("BondSchedule_QuarterlyToggle")"
                               Color="MudBlazor.Color.Primary" Class="mb-2" />
                    <MudGrid Spacing="4" Style="height:100%;">
                        <MudItem xs="12" md="@(ViewModel.SelectedPeriodEntry is null ? 12 : 7)" Style="height:100%;">
                            <BondScheduleChart @key="@($"{ViewModel.BondScheduleQuarterlyView}:{ViewModel.SelectedPeriodEntry is null}")"
                                               Items="@ViewModel.BondScheduleDisplayed"
                                               OnPeriodClicked="@(entry => ViewModel.SelectPeriod(entry))" />
                        </MudItem>
                        @if (ViewModel.SelectedPeriodEntry is { } selected)
                        {
                            <MudItem xs="12" md="5">
                                <BondScheduleDetailTable PeriodLabel="@selected.Label" Bonds="@ViewModel.SelectedPeriodBonds" Total="@selected.Amount" />
                            </MudItem>
                        }
                    </MudGrid>
                }
            </div>
        </MudTabPanel>
    </MudTabs>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }
}
