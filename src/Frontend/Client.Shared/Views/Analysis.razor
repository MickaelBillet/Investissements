@page "/analyse"
@inject AnalysisViewModel ViewModel
@inject ILocalizationService L
@implements IDisposable

<PageTitle>@L.Translate("Nav_AppTitle")</PageTitle>

@if (ViewModel.IsAvailable)
{
    <MudStack Spacing="3">
        @* An explicit button rather than a start on opening: each run costs model tokens. *@
        @* Side by side rather than swapped in place: a double click on Launch must not cancel the run it has just started. *@
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Disabled="@ViewModel.IsRunning" OnClick="ViewModel.LaunchAsync">
                @L.Translate("Analysis_Launch")
            </MudButton>
            @if (ViewModel.IsRunning)
            {
                <MudButton Variant="Variant.Outlined" OnClick="ViewModel.Cancel">@L.Translate("Analysis_Cancel")</MudButton>
            }
        </MudStack>

        @if (ViewModel.ShowSteps)
        {
            <AnalysisStepList Steps="ViewModel.Steps" />
        }

        @if (ViewModel.IsCancelled)
        {
            <MudText Typo="Typo.body2">@L.Translate("Analysis_Cancelled")</MudText>
        }
        else if (ViewModel.Error is not null)
        {
            <MudAlert Severity="Severity.Error">@L.Translate("Analysis_Error") — @ViewModel.Error</MudAlert>
        }
        else if (ViewModel.Report is not null)
        {
            <MudText Typo="Typo.caption">@L.Translate("Analysis_ReportDate") @ViewModel.ReportDate?.ToString("dd/MM/yyyy")</MudText>
            <SynthesisReportView Report="ViewModel.Report" />
        }
    </MudStack>
}

@code {
    protected override void OnInitialized() => ViewModel.StepsChanged += OnStepsChanged;

    // The workflow may report from a background thread: the render has to go back through the dispatcher.
    private void OnStepsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ViewModel.StepsChanged -= OnStepsChanged;
        ViewModel.Cancel();
    }
}
