@page "/suivi"
@inject SuiviViewModel ViewModel
@inject ILocalizationService L

<PageTitle>Suivi des Investissements</PageTitle>

@if (ViewModel.IsLoading)
{
    <MudStack AlignItems="AlignItems.Center" Style="padding:64px 0;">
        <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Primary" />
    </MudStack>
}
else
{
    <MudTabs Rounded="true" ApplyEffectsToContainer="true">
        <MudTabPanel Text="@L.Translate("Suivi_Tab_History")">
            <div style="height: calc(100vh - 230px);">
                @if (ViewModel.HistoryError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@ViewModel.HistoryError</MudAlert>
                }
                else
                {
                    <HistoryChart ROIC_Series="@ViewModel.ROIC_Series"
                                  LifeStrategySeries="@ViewModel.LifeStrategySeries"
                                  MsciWorldSeries="@ViewModel.MsciWorldSeries" />
                }
            </div>
        </MudTabPanel>
        <MudTabPanel Text="@L.Translate("Suivi_Tab_BondSchedule")">
            <div style="height: calc(100vh - 230px);overflow-y:auto;">
                @if (ViewModel.BondScheduleError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@ViewModel.BondScheduleError</MudAlert>
                }
                else
                {
                    <MudSwitch T="bool" Value="@ViewModel.BondScheduleQuarterlyView"
                               ValueChanged="@OnGranularityChanged"
                               Label="@L.Translate("BondSchedule_QuarterlyToggle")"
                               Color="MudBlazor.Color.Primary" Class="mb-2" />
                    <MudGrid Spacing="4" Style="height:100%;">
                        <MudItem xs="12" md="@(_selectedPeriodEntry is null ? 12 : 7)" Style="height:100%;">
                            <BondScheduleChart @key="@($"{ViewModel.BondScheduleQuarterlyView}:{_selectedPeriodEntry is null}")"
                                               Items="@ViewModel.BondScheduleDisplayed"
                                               OnPeriodClicked="@(entry => _selectedPeriodEntry = entry)" />
                        </MudItem>
                        @if (_selectedPeriodEntry is not null)
                        {
                            <MudItem xs="12" md="5">
                                <BondScheduleDetailTable PeriodLabel="@_selectedPeriodEntry.Label" Bonds="@_selectedPeriodEntry.Bonds" Total="@_selectedPeriodEntry.Amount" />
                            </MudItem>
                        }
                    </MudGrid>
                }
            </div>
        </MudTabPanel>
    </MudTabs>
}

@code {
    private BondSchedulePeriodDto? _selectedPeriodEntry;

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private void OnGranularityChanged(bool value)
    {
        ViewModel.BondScheduleQuarterlyView = value;
        _selectedPeriodEntry = null;
    }
}
