@page "/suivi"
@inject SuiviViewModel ViewModel
@inject ILocalizationService L

<PageTitle>Suivi des Investissements</PageTitle>

@if (ViewModel.IsLoading)
{
    <MudStack AlignItems="AlignItems.Center" Style="padding:64px 0;">
        <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Primary" />
    </MudStack>
}
else
{
    <MudTabs Rounded="true" ApplyEffectsToContainer="true">
        <MudTabPanel Text="@L.Translate("Suivi_Tab_History")">
            <div style="height: calc(100vh - 230px);">
                @if (ViewModel.HistoryError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@ViewModel.HistoryError</MudAlert>
                }
                else
                {
                    <HistoryChart ROIC_Series="@ViewModel.ROIC_Series"
                                  LifeStrategySeries="@ViewModel.LifeStrategySeries"
                                  MsciWorldSeries="@ViewModel.MsciWorldSeries" />
                }
            </div>
        </MudTabPanel>
        <MudTabPanel Text="@L.Translate("Suivi_Tab_BondSchedule")">
            <div style="height: calc(100vh - 230px);">
                @if (ViewModel.BondScheduleError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@ViewModel.BondScheduleError</MudAlert>
                }
                else
                {
                    <BondScheduleChart Items="@ViewModel.BondSchedule" />
                }
            </div>
        </MudTabPanel>
    </MudTabs>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }
}
