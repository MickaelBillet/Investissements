@implements IDisposable
@inject ILocalizationService L
@inject IPrivacyModeService Privacy

@if (!string.IsNullOrEmpty(Title))
{
    <MudText Typo="Typo.h3" Class="mb-2">@Title</MudText>
}

<MudTable Items="@Assets" Dense="true" Hover="true" Elevation="0"
          Style="border:1px solid #E9E9E7;border-radius:6px;margin-top:16px;">
    <HeaderContent>
        <MudTh Style="color:#787774;font-size:12px;">@L.Translate("Col_Name")</MudTh>
        <MudTh Style="color:#787774;font-size:12px;text-align:right;">@L.Translate("Col_CurrentValue")</MudTh>
        @if (Coefficients is not null)
        {
            <MudTh Style="color:#787774;font-size:12px;text-align:right;">@L.Translate("Col_GeoCoefficient")</MudTh>
        }
        <MudTh Style="color:#787774;font-size:12px;text-align:right;">@L.Translate("Col_UnrealizedGain")</MudTh>
        <MudTh Style="color:#787774;font-size:12px;text-align:right;">@L.Translate("Col_ROI")</MudTh>
        <MudTh Style="color:#787774;font-size:12px;text-align:right;">@L.Translate("Col_Yield")</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@L.Translate("Col_Name")" Style="font-weight:500;">@context.Name</MudTd>
        <MudTd DataLabel="@L.Translate("Col_CurrentValue")" Style="text-align:right;">
            @context.CurrentTotal.ToEurAmount(Privacy.IsHidden)
        </MudTd>
        @if (Coefficients is not null)
        {
            <MudTd DataLabel="@L.Translate("Col_GeoCoefficient")" Style="text-align:right;">
                @(Coefficients.TryGetValue(context.Id, out var coefficient) ? (coefficient * 100m).ToPercentage(1) : "—")
            </MudTd>
        }
        <MudTd DataLabel="@L.Translate("Col_UnrealizedGain")" Style="text-align:right;"
               Class="@context.UnrealizedGain.CssRoiClass()">
            @context.UnrealizedGain.ToEurAmount(Privacy.IsHidden)
        </MudTd>
        <MudTd DataLabel="@L.Translate("Col_ROI")" Style="text-align:right;"
               Class="@context.Roi.CssRoiClass()">
            @context.Roi.ToPercentage()
        </MudTd>
        <MudTd DataLabel="@L.Translate("Col_Yield")" Style="text-align:right;">
            @context.Yield.ToPercentage()
        </MudTd>
    </RowTemplate>
    <FooterContent>
        <MudTd Style="font-weight:600;">@L.Translate("Table_Total")</MudTd>
        <MudTd Style="text-align:right;font-weight:600;">
            @WeightedTotal().ToEurAmount(Privacy.IsHidden)
        </MudTd>
        @if (Coefficients is not null)
        {
            <MudTd />
        }
        <MudTd /><MudTd /><MudTd />
    </FooterContent>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Style="color:#787774;padding:16px;">@L.Translate("Empty_NoAsset")</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AssetDto> Assets { get; set; } = [];
    [Parameter]                 public string?                  Title  { get; set; }

    // Per-asset zone coefficient (0–1), keyed by AssetDto.Id — when provided, an extra
    // column is shown and the footer total is weighted instead of summing CurrentTotal.
    [Parameter]                 public IReadOnlyDictionary<int, decimal>? Coefficients { get; set; }

    private decimal WeightedTotal() =>
        Coefficients is null
            ? Assets.Sum(a => a.CurrentTotal ?? 0m)
            : Assets.Sum(a => (a.CurrentTotal ?? 0m) * (Coefficients.TryGetValue(a.Id, out var c) ? c : 0m));

    protected override void OnInitialized() => Privacy.OnChange += StateHasChanged;

    public void Dispose() => Privacy.OnChange -= StateHasChanged;
}
