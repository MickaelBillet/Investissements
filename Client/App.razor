@implements IDisposable
@inject ILocalizationService L
@inject ISessionService Session

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />

@if (!_initialized)
{
    <MudProgressCircular Indeterminate="true" Style="margin:48px auto;display:block;" />
}
else if (!Session.IsAuthenticated)
{
    <LoginGate />
}
else
{
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <MudText Typo="Typo.h3" Class="pa-8">@L.Translate("Error_PageNotFound")</MudText>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += StateHasChanged;
        await Session.InitializeAsync();
        _initialized = true;
    }

    public void Dispose() => Session.OnChange -= StateHasChanged;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Background       = "#FFFFFF",
            Surface          = "#FAFAFA",
            TextPrimary      = "#37352F",
            TextSecondary    = "#787774",
            Primary          = "#2383E2",
            PrimaryContrastText = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText       = "#37352F",
            TableLines       = "#E9E9E7",
            TableStriped     = "#FAFAFA",
            TableHover       = "#FAFAFA",
            Divider          = "#E9E9E7",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Helvetica", "Arial", "sans-serif"],
                FontSize   = "14px",
                FontWeight = "400"
            },
            H1 = new H1Typography { FontSize = "40px", FontWeight = "700" },
            H2 = new H2Typography { FontSize = "24px", FontWeight = "600" },
            H3 = new H3Typography { FontSize = "18px", FontWeight = "600" },
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px" }
    };
}
