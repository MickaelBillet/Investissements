@inherits LayoutComponentBase
@implements IDisposable
@inject ILocalizationService L
@inject IPrivacyModeService Privacy
@inject ISessionService Session
@inject SyncViewModel SyncViewModel
@inject ISnackbar Snackbar

<MudLayout>
    <MudAppBar Elevation="0" Dense="false" Color="MudBlazor.Color.Surface"
               Style="border-bottom:1px solid #E9E9E7;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <img src="icon.svg" alt="logo" style="width:18px;height:18px;" />
            <MudText Style="font-size:18px;font-weight:700;color:#37352F;">
                @L.Translate("Nav_AppTitle")
            </MudText>
        </MudStack>
        <MudSpacer />
        <MudButton Href="/" Color="MudBlazor.Color.Default" Variant="Variant.Text"
                   StartIcon="@Icons.Material.Outlined.PieChart">
            @L.Translate("Nav_Portfolio")
        </MudButton>
        <MudButton Href="/suivi" Color="MudBlazor.Color.Default" Variant="Variant.Text"
                   StartIcon="@Icons.Material.Outlined.Timeline">
            @L.Translate("Nav_Suivi")
        </MudButton>
        <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Color="MudBlazor.Color.Default" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@(Privacy.IsHidden ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                         OnClick="@(() => Privacy.ToggleAsync())">
                @(Privacy.IsHidden ? L.Translate("Nav_ShowAmounts") : L.Translate("Nav_HideAmounts"))
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.Sync" OnClick="@OnSyncClicked" Disabled="@SyncViewModel.IsSyncing">
                @if (SyncViewModel.IsSyncing)
                {
                    <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" />
                }
                else
                {
                    @L.Translate("Nav_Sync")
                }
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.PictureAsPdf" Href="docs/presentation.pdf" Target="_blank">
                @L.Translate("Nav_Documentation")
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="@(() => Session.LogoutAsync())">
                @L.Translate("Nav_Logout")
            </MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge"
                      Style="padding-top:32px;padding-bottom:48px;">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Privacy.InitializeAsync();
        Privacy.OnChange += StateHasChanged;
    }

    public void Dispose() => Privacy.OnChange -= StateHasChanged;

    private async Task OnSyncClicked()
    {
        var result = await SyncViewModel.TriggerAsync();

        if (result.Success)
        {
            var message = result.AddedCount > 0
                ? string.Format(L.Translate("Sync_Success_WithAdded"), result.AddedCount)
                : L.Translate("Sync_Success_NoAdded");
            Snackbar.Add(message, MudBlazor.Severity.Success);
        }
        else
        {
            var message = string.IsNullOrEmpty(result.ErrorMessage)
                ? L.Translate("Sync_Error")
                : $"{L.Translate("Sync_Error")} — {result.ErrorMessage}";
            Snackbar.Add(message, MudBlazor.Severity.Error);
        }
    }
}
